{
  "manifest_version": 3,
  "name": "Wingman",
  "version": "0.1.0",
  "description": "Capture a screenshot or screen recording and file a clean Trello card.",
  "permissions": ["activeTab", "tabs", "storage", "notifications"],
  "host_permissions": ["https://api.trello.com/*", "https://api.groq.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "run_at": "document_idle",
      "js": [
        "src/storage.js",
        "src/markdown.js",
        "src/trello.js",
        "src/capture.js",
        "src/overlay.js",
        "src/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/styles.css"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "action": {
    "default_title": "Wingman — capture a bug or feedback"
  },
  "options_page": "src/options.html",
  "commands": {
    "activate-wingman": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Capture a screenshot / recording with Wingman"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
