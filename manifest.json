{
  "manifest_version": 3,
  "name": "Wingman",
  "version": "1.0.11",
  "description": "Capture a screenshot or screen recording and file a clean Trello card.",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "notifications"],
  "host_permissions": [
    "https://api.trello.com/*",
    "https://api.groq.com/*",
    "https://wingman-files.lamp-greg.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/console-capture.js"]
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "run_at": "document_idle",
      "js": [
        "src/storage.js",
        "src/markdown.js",
        "src/trello.js",
        "src/r2.js",
        "src/capture.js",
        "src/draw.js",
        "src/overlay.js",
        "src/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/styles.css"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "action": {
    "default_title": "Wingman — capture a bug or feedback"
  },
  "options_page": "src/options.html",
  "commands": {
    "activate-wingman": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Capture a screenshot / recording with Wingman"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
